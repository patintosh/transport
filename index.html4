<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<title>Recherche documentaire</title>
<style>
    body {
        font-family: Arial, sans-serif;
        text-align: center;
        margin-top: 120px;
        background: #f7f7f7;
    }
    h1 {
        font-size: 36px;
        margin-bottom: 40px;
        color: #333;
    }
    #searchBox {
        width: 60%;
        padding: 14px;
        font-size: 18px;
        border: 1px solid #aaa;
        border-radius: 6px;
        outline: none;
    }
    #searchBox:focus {
        border-color: #0078d4;
    }
    #searchButton {
        padding: 14px 24px;
        font-size: 18px;
        margin-left: 10px;
        border: none;
        background-color: #0078d4;
        color: white;
        border-radius: 6px;
        cursor: pointer;
    }
    #searchButton:hover {
        background-color: #005fa3;
    }
</style>
</head>
<body>

<h1>Recherche documentaire</h1>

<input id="searchBox" type="text" placeholder="Tapez votre recherche…">
<button id="searchButton">Rechercher</button>

<script>
document.getElementById("searchButton").onclick = function() {
    const q = document.getElementById("searchBox").value;
    if (q.trim() !== "") {
        window.location.href = "search.html?q=" + encodeURIComponent(q);
    }
};
document.getElementById("searchBox").addEventListener("keypress", function(e) {
    if (e.key === "Enter") {
        document.getElementById("searchButton").click();
    }
});
</script>

</body>
</html>
